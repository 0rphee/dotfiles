{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "color": {
      "keys": "1",
      "title": "0",
      "output": "0"
    },
    "size": {
      "ndigits": 1
    },
    "percent": {
      "ndigits": 1,
      "color": {
        "green": "0",
        "yellow": "0",
        "red": "0"
      },
    },
    "temp": {
      "ndigits": 1
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "   ▄                          ▄\n  ▄▀    ▄▄    ▄▄ ▄     ▄▄    ▄▀ ▄\n  █   ▄▀  █   █ █ █  ▄▀  █   █▄▀\n █    ▀▄▄▀▄  █ █ █   ▀▄▄▀▄  █  ▀▄"
    },
    "break",
    "uptime",
    "memory",
    "battery"
  ]
}